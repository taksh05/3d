{
  "headers": [
    {
      "source": "/models/(.*).usdz",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/vnd.usdz+zip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/(.*).glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/autoar",
      "destination": "/index.html"
    },
    {
      "source": "/arview",
      "destination": "/index.html"
    },
    {
      "source": "/((?!models|assets|favicon).*)",
      "destination": "/index.html"
    }
  ]
}