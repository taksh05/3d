{
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "model/vnd.usdz+zip" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/autoar", "destination": "/index.html" },
    { "source": "/arview", "destination": "/index.html" },
    
    { "source": "/((?!models/).*)", "destination": "/index.html" }
  ]
}